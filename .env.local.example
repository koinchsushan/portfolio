# Copy to .env.local and fill in to enable the contact form's email send.
# Without RESEND_API_KEY, POST /api/contact returns 503 and sends nothing;
# the rest of the site, including `npm run build`, works fine without it.

# Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where a submitted message is delivered. Defaults to koinchsushan@gmail.com
# if unset.
CONTACT_TO=koinchsushan@gmail.com
